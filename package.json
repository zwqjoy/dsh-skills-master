{
  "name": "dsh-skills-master",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.json",
    "LICENSES"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run test:browser && npm run test:package",
    "test:live": "node --import tsx scripts/verify-live.ts",
    "test:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
